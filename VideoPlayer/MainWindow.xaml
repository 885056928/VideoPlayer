<Window
    x:Class="VideoPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:views="clr-namespace:VideoPlayer.Views"
    Title="VideoPlayer"
    Width="1180"
    Height="720"
    MinWidth="900"
    MinHeight="540"
    Background="#0B0B0B">
    <!-- 42 像素顶栏包含 6 像素缩放边缘与 36 像素标题区，保留系统拖动和双击行为。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="36"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Template>
        <ControlTemplate TargetType="{x:Type Window}">
            <Border Background="{TemplateBinding Background}">
                <AdornerDecorator>
                    <ContentPresenter />
                </AdornerDecorator>
            </Border>
        </ControlTemplate>
    </Window.Template>
    <Window.Resources>
        <Style x:Key="HeaderIconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="AppHeader"
            Grid.Row="0"
            Height="42"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="16"
                        Foreground="{DynamicResource AccentBrush}"
                        Text="&#xE714;" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        Text="VideoPlayer" />
                </StackPanel>

                <TextBlock
                    x:Name="HeaderMediaTitleText"
                    Grid.Column="1"
                    Margin="16,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Text="{Binding Player.MediaTitle}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Player.MediaTitle}" />

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <Button
                        x:Name="HeaderOpenFolderButton"
                        AutomationProperties.Name="打开视频文件夹"
                        Click="OpenFolder_Click"
                        Content="&#xE8B7;"
                        Style="{StaticResource HeaderIconButtonStyle}"
                        ToolTip="打开视频文件夹" />
                    <Button
                        x:Name="HeaderFullscreenButton"
                        AutomationProperties.Name="全屏"
                        Click="ToggleFullscreen_Click"
                        Content="&#xE740;"
                        Style="{StaticResource HeaderIconButtonStyle}"
                        ToolTip="全屏（F11 / Esc 退出）" />
                    <Button
                        x:Name="TogglePlaylistButton"
                        AutomationProperties.Name="显示或隐藏播放列表"
                        Click="TogglePlaylist_Click"
                        Content="&#xE76C;"
                        Style="{StaticResource HeaderIconButtonStyle}"
                        ToolTip="隐藏播放列表" />
                    <Button
                        x:Name="MinimizeWindowButton"
                        AutomationProperties.Name="最小化"
                        Click="MinimizeWindow_Click"
                        Content="&#xE921;"
                        Style="{StaticResource HeaderIconButtonStyle}"
                        ToolTip="最小化" />
                    <Button
                        x:Name="MaximizeWindowButton"
                        Click="ToggleMaximizeWindow_Click">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource HeaderIconButtonStyle}">
                                <Setter Property="Content" Value="&#xE922;" />
                                <Setter Property="ToolTip" Value="最大化" />
                                <Setter Property="AutomationProperties.Name" Value="最大化" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                        <Setter Property="Content" Value="&#xE923;" />
                                        <Setter Property="ToolTip" Value="还原" />
                                        <Setter Property="AutomationProperties.Name" Value="还原" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button
                        x:Name="CloseWindowButton"
                        AutomationProperties.Name="关闭"
                        Click="CloseWindow_Click"
                        Content="&#xE8BB;"
                        Style="{StaticResource HeaderIconButtonStyle}"
                        ToolTip="关闭" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ContentLayout" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PlaylistColumn" Width="320" />
            </Grid.ColumnDefinitions>

            <views:PlayerView x:Name="PlayerView" DataContext="{Binding Player}" />
            <views:PlaylistView
                x:Name="PlaylistView"
                Grid.Column="1"
                DataContext="{Binding Playlist}" />
        </Grid>
    </Grid>
</Window>
