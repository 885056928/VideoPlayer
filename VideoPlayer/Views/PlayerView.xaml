<UserControl x:Class="VideoPlayer.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF">
    <Grid>
        <vlc:VideoView x:Name="VideoView"
                       MediaPlayer="{Binding MediaPlayer}"
                       Background="{DynamicResource BackgroundBrush}">
            <Grid x:Name="OverlayRoot" Background="Transparent">
                <Grid IsHitTestVisible="False">
                    <Border x:Name="EmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="28,22"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PlaybackState}" Value="None" />
                                            <Condition Binding="{Binding HasError}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="打开视频文件或文件夹"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="支持常见视频格式，也可以将文件拖放到右侧播放列表"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="LoadingState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="28,22"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlaybackState}" Value="Opening">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="正在打开…"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="18"
                                       HorizontalAlignment="Center" />
                            <ProgressBar Width="170"
                                         Height="3"
                                         Margin="0,14,0,0"
                                         IsIndeterminate="True"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource ControlBorderBrush}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ErrorState"
                            MaxWidth="520"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="24,18"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource ErrorBrush}"
                            BorderThickness="2"
                            CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="播放出错"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LastError}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ScreenshotBanner"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="16"
                            Padding="14,9"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasScreenshotMessage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ScreenshotMessage}"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </Border>
                </Grid>

                <Border x:Name="ControlBar"
                        VerticalAlignment="Bottom"
                        Background="#D91B1B1B"
                        Padding="8">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="打开" Click="Open_Click" Margin="4" />
                        <Button Content="播放" Command="{Binding PlayCommand}" Margin="4" />
                        <Button Content="暂停" Command="{Binding PauseCommand}" Margin="4" />
                        <Button Content="停止" Command="{Binding StopCommand}" Margin="4" />
                        <Slider x:Name="SeekSlider"
                                Width="220"
                                Minimum="0"
                                IsMoveToPointEnabled="True"
                                Maximum="{Binding Duration.TotalSeconds, Mode=OneWay}"
                                Value="{Binding PendingSeekPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                                LostMouseCapture="SeekSlider_LostMouseCapture"
                                PreviewKeyDown="SeekSlider_PreviewKeyDown"
                                PreviewKeyUp="SeekSlider_PreviewKeyUp" />
                        <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center">
                            <Run Text="{Binding Position}" /><Run Text=" / " /><Run Text="{Binding Duration}" />
                        </TextBlock>
                        <Slider Width="120"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding Volume}" />
                        <Button Content="静音" Command="{Binding ToggleMuteCommand}" />
                        <TextBlock Text="{Binding Rate, StringFormat={}{0:0.00}x}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </vlc:VideoView>
    </Grid>
</UserControl>
