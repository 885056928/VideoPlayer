<UserControl x:Class="VideoPlayer.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF">
    <UserControl.Resources>
        <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="PlayerLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <vlc:VideoView x:Name="VideoView"
                       Grid.Row="0"
                       MediaPlayer="{Binding MediaPlayer}"
                       Background="{DynamicResource BackgroundBrush}">
            <Grid x:Name="OverlayRoot" Background="Transparent">
                <Grid IsHitTestVisible="False">
                    <Border x:Name="EmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="28,22"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PlaybackState}" Value="None" />
                                            <Condition Binding="{Binding HasError}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="打开视频文件或文件夹"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="支持常见视频格式，也可以将文件拖放到右侧播放列表"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="LoadingState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="28,22"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlaybackState}" Value="Opening">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="正在打开…"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="18"
                                       HorizontalAlignment="Center" />
                            <ProgressBar Width="170"
                                         Height="3"
                                         Margin="0,14,0,0"
                                         IsIndeterminate="True"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource ControlBorderBrush}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ErrorState"
                            MaxWidth="520"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="24,18"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource ErrorBrush}"
                            BorderThickness="2"
                            CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="播放出错"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LastError}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ScreenshotBanner"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="16"
                            Padding="14,9"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasScreenshotMessage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ScreenshotMessage}"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </Border>
                </Grid>

            </Grid>
        </vlc:VideoView>

        <Border x:Name="ControlBar" Grid.Row="1"
                VerticalAlignment="Bottom"
                Background="#D91B1B1B"
                Padding="8">
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="OpenButton"
                        Style="{StaticResource IconButtonStyle}"
                        Content="&#xE8E5;"
                        Click="Open_Click"
                        ToolTip="打开视频"
                        AutomationProperties.Name="打开视频" />
                <Button x:Name="PlayButton"
                        Style="{StaticResource IconButtonStyle}"
                        Content="&#xE768;"
                        Command="{Binding PlayCommand}"
                        ToolTip="播放"
                        AutomationProperties.Name="播放" />
                <Button x:Name="PauseButton"
                        Style="{StaticResource IconButtonStyle}"
                        Content="&#xE769;"
                        Command="{Binding PauseCommand}"
                        ToolTip="暂停"
                        AutomationProperties.Name="暂停" />
                <Button x:Name="StopButton"
                        Style="{StaticResource IconButtonStyle}"
                        Content="&#xE71A;"
                        Command="{Binding StopCommand}"
                        ToolTip="停止"
                        AutomationProperties.Name="停止" />
                <Button x:Name="PreviousButton"
                        Style="{StaticResource IconButtonStyle}"
                        Content="&#xE892;"
                        Command="{Binding PreviousCommand}"
                        ToolTip="上一项"
                        AutomationProperties.Name="上一项" />
                <Button x:Name="NextButton"
                        Style="{StaticResource IconButtonStyle}"
                        Content="&#xE893;"
                        Command="{Binding NextCommand}"
                        ToolTip="下一项"
                        AutomationProperties.Name="下一项" />
                <ComboBox Width="110"
                          Margin="4"
                          ItemsSource="{Binding AudioTracks}"
                          SelectedItem="{Binding SelectedAudioTrack, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          ToolTip="音轨" />
                <ComboBox Width="110"
                          Margin="4"
                          ItemsSource="{Binding SubtitleTracks}"
                          SelectedItem="{Binding SelectedSubtitleTrack, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          ToolTip="字幕轨" />
                <Button x:Name="CloseSubtitleButton"
                        Style="{StaticResource IconButtonStyle}"
                        Content="&#xE8BA;"
                        Command="{Binding CloseSubtitleCommand}"
                        ToolTip="关闭字幕"
                        AutomationProperties.Name="关闭字幕" />
                <Button x:Name="AddSubtitleButton"
                        Style="{StaticResource IconButtonStyle}"
                        Content="&#xED1E;"
                        Click="AddSubtitle_Click"
                        ToolTip="添加字幕"
                        AutomationProperties.Name="添加字幕" />
                <Button x:Name="ScreenshotButton"
                        Style="{StaticResource IconButtonStyle}"
                        Content="&#xE722;"
                        Command="{Binding ScreenshotCommand}"
                        ToolTip="截图"
                        AutomationProperties.Name="截图" />
                <Slider x:Name="SeekSlider"
                        Width="220"
                        Minimum="0"
                        IsMoveToPointEnabled="True"
                        Maximum="{Binding Duration.TotalSeconds, Mode=OneWay}"
                        Value="{Binding PendingSeekPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                        LostMouseCapture="SeekSlider_LostMouseCapture"
                        PreviewKeyDown="SeekSlider_PreviewKeyDown"
                        PreviewKeyUp="SeekSlider_PreviewKeyUp" />
                <TextBlock Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center">
                    <Run Text="{Binding Position}" /><Run Text=" / " /><Run Text="{Binding Duration}" />
                </TextBlock>
                <Slider Width="120"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding Volume}" />
                <Button x:Name="MuteButton"
                        Style="{StaticResource IconButtonStyle}"
                        Content="&#xE74F;"
                        Command="{Binding ToggleMuteCommand}"
                        ToolTip="静音/取消静音"
                        AutomationProperties.Name="静音或取消静音" />
                <TextBlock Text="{Binding Rate, StringFormat={}{0:0.00}x}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center" />
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
