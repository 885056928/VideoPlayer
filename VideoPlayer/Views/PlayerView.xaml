<UserControl x:Class="VideoPlayer.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:converters="clr-namespace:VideoPlayer.Converters">
    <UserControl.Resources>
        <converters:TimeSpanToTextConverter x:Key="TimeSpanToTextConverter" />

        <Style x:Key="ProgressTrackButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Height="4"
                                CornerRadius="2"
                                Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProgressThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Ellipse Fill="{DynamicResource PrimaryTextBrush}"
                                 Stroke="{DynamicResource AccentBrush}"
                                 StrokeThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MediaProgressSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="20" />
            <Setter Property="Background" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid>
                            <Border Height="4"
                                    CornerRadius="2"
                                    Background="{TemplateBinding Background}"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ProgressTrackButtonStyle}"
                                                  Background="{DynamicResource AccentBrush}"
                                                  Command="{x:Static Slider.DecreaseLarge}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ProgressThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ProgressTrackButtonStyle}"
                                                  Background="{DynamicResource ControlBorderBrush}"
                                                  Command="{x:Static Slider.IncreaseLarge}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlPressedBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CenterPlaybackButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Ellipse x:Name="Ring"
                                     Fill="{DynamicResource SurfaceBrush}"
                                     Stroke="{DynamicResource ControlBorderBrush}"
                                     StrokeThickness="2" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource ControlPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>    </UserControl.Resources>
    <Grid x:Name="PlayerLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <vlc:VideoView x:Name="VideoView"
                       Grid.Row="0"
                       MediaPlayer="{Binding MediaPlayer}"
                       Background="{DynamicResource BackgroundBrush}">
            <Grid x:Name="OverlayRoot" Background="Transparent">
                <Grid IsHitTestVisible="False">
                    <Border x:Name="EmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="28,22"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding PlaybackState}" Value="None" />
                                            <Condition Binding="{Binding HasError}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel x:Name="EmptyStatePanel"
                                    HorizontalAlignment="Center">
                            <Border Width="76"
                                    Height="76"
                                    CornerRadius="16"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="&#xE714;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="34"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="VideoPlayer"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Margin="0,14,0,0"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="本地视频播放器"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center" />
                            <Button x:Name="PrimaryOpenButton"
                                    HorizontalAlignment="Center"
                                    Margin="0,18,0,0"
                                    Padding="14,7"
                                    Click="Open_Click"
                                    ToolTip="打开视频"
                                    AutomationProperties.Name="打开视频">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="打开文件" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border x:Name="LoadingState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="28,22"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PlaybackState}" Value="Opening">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="正在打开…"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="18"
                                       HorizontalAlignment="Center" />
                            <ProgressBar Width="170"
                                         Height="3"
                                         Margin="0,14,0,0"
                                         IsIndeterminate="True"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Background="{DynamicResource ControlBorderBrush}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ErrorState"
                            MaxWidth="520"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="24,18"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource ErrorBrush}"
                            BorderThickness="2"
                            CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="播放出错"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LastError}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ScreenshotBanner"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="16"
                            Padding="14,9"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasScreenshotMessage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ScreenshotMessage}"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </Border>
                </Grid>

            </Grid>
        </vlc:VideoView>

        <Border x:Name="ControlBar" Grid.Row="1"
                VerticalAlignment="Bottom"
                Background="#D91B1B1B"
                Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="SeekGroup" Margin="6,0,6,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="SeekSlider"
                            Style="{StaticResource MediaProgressSliderStyle}"
                            Minimum="0"
                            IsMoveToPointEnabled="True"
                            Maximum="{Binding Duration.TotalSeconds, Mode=OneWay}"
                            Value="{Binding PendingSeekPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                            LostMouseCapture="SeekSlider_LostMouseCapture"
                            PreviewKeyDown="SeekSlider_PreviewKeyDown"
                            PreviewKeyUp="SeekSlider_PreviewKeyUp"
                            MouseMove="SeekSlider_MouseMove"
                            MouseLeave="SeekSlider_MouseLeave" />
                    <TextBlock Grid.Column="1"
                               Margin="12,0,4,0"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               VerticalAlignment="Center">
                        <Run Text="{Binding Position, Converter={StaticResource TimeSpanToTextConverter}}" /><Run Text=" / " /><Run Text="{Binding Duration, Converter={StaticResource TimeSpanToTextConverter}}" />
                    </TextBlock>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="OpenButton"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE8E5;"
                                Click="Open_Click"
                                ToolTip="打开视频"
                                AutomationProperties.Name="打开视频" />
                        <Button x:Name="AddSubtitleButton"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xED1E;"
                                Click="AddSubtitle_Click"
                                ToolTip="添加字幕"
                                AutomationProperties.Name="添加字幕" />
                        <Button x:Name="ScreenshotButton"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE722;"
                                Command="{Binding ScreenshotCommand}"
                                ToolTip="截图"
                                AutomationProperties.Name="截图" />
                    </StackPanel>

                    <StackPanel x:Name="PlaybackGroup"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button x:Name="StopButton"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE71A;"
                                Command="{Binding StopCommand}"
                                ToolTip="停止"
                                AutomationProperties.Name="停止" />
                        <Button x:Name="PreviousButton"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE892;"
                                Command="{Binding PreviousCommand}"
                                ToolTip="上一项"
                                AutomationProperties.Name="上一项" />
                        <Button x:Name="PlayPauseButton"
                                Command="{Binding TogglePlaybackCommand}"
                                ToolTip="播放"
                                AutomationProperties.Name="播放">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}"
                                       BasedOn="{StaticResource CenterPlaybackButtonStyle}">
                                    <Setter Property="Content" Value="&#xE768;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlaybackState}" Value="Playing">
                                            <Setter Property="Content" Value="&#xE769;" />
                                            <Setter Property="ToolTip" Value="暂停" />
                                            <Setter Property="AutomationProperties.Name" Value="暂停" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="NextButton"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE893;"
                                Command="{Binding NextCommand}"
                                ToolTip="下一项"
                                AutomationProperties.Name="下一项" />
                        <Button x:Name="MuteButton"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE74F;"
                                Command="{Binding ToggleMuteCommand}"
                                ToolTip="静音/取消静音"
                                AutomationProperties.Name="静音或取消静音" />
                        <Slider x:Name="VolumeSlider"
                                Width="110"
                                Margin="8,0,4,0"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding Volume}"
                                ToolTip="音量"
                                AutomationProperties.Name="音量" />
                    </StackPanel>
                    <StackPanel x:Name="TrackToolsGroup"
                                Grid.Column="2"
                                Orientation="Horizontal">
                        <ComboBox Width="105"
                                  Margin="4"
                                  ItemsSource="{Binding AudioTracks}"
                                  SelectedItem="{Binding SelectedAudioTrack, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  ToolTip="音轨"
                                  AutomationProperties.Name="音轨" />
                        <ComboBox Width="105"
                                  Margin="4"
                                  ItemsSource="{Binding SubtitleTracks}"
                                  SelectedItem="{Binding SelectedSubtitleTrack, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  ToolTip="字幕轨"
                                  AutomationProperties.Name="字幕轨" />
                        <Button x:Name="CloseSubtitleButton"
                                Style="{StaticResource IconButtonStyle}"
                                Content="&#xE8BA;"
                                Command="{Binding CloseSubtitleCommand}"
                                ToolTip="关闭字幕"
                                AutomationProperties.Name="关闭字幕" />

                        <TextBlock Text="{Binding Rate, StringFormat={}{0:0.00}x}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="4,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Popup x:Name="SeekPreviewPopup"
               Placement="Mouse"
               PlacementTarget="{Binding ElementName=SeekSlider}"
               AllowsTransparency="True"
               StaysOpen="True"
               IsHitTestVisible="False"
               HorizontalOffset="-100"
               VerticalOffset="-132">
            <Border Background="#E61B1B1B"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="6">
                <StackPanel>
                    <Border Width="180"
                            Height="101"
                            Background="#050505"
                            CornerRadius="4"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <TextBlock Text="&#xE714;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="28"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Image Source="{Binding HoverPreviewPath}"
                                   Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding HoverTimeText}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Popup>    </Grid>
</UserControl>
